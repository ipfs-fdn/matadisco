{
  "$type": "com.atproto.lexicon.schema",
  "lexicon": 1,
  "id": "cx.vmx.matadisco",
  "defs": {
    "main": {
      "type": "record",
      "description": "A Matadisco record",
      "key": "any",
      "record": {
        "type": "object",
        "required": [
          "publishedAt",
          "resource"
        ],
        "properties": {
          "publishedAt": {
            "type": "string",
            "format": "datetime",
            "description": "The time the original metadata/data was published"
          },
          "resource": {
            "type": "string",
            "format": "uri",
            "description": "A URI that links to resource containing the metadata"
          },
          "preview": {
            "type": "ref",
            "ref": "#preview"
          },
          "tags": {
            "type": "ref",
            "ref": "#tags"
          }
        }
      }
    },
    "preview": {
      "type": "object",
      "description": "Preview of the data",
      "required": [
        "mimeType"
      ],
      "properties": {
        "mimeType": {
          "type": "string",
          "description": "The media type the preview has"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "description": "The URL to the preview"
        }
      }
    },
    "tags": {
      "type": "array",
      "description": "Tags that describe the metadata. A tag might have a corresponding top-level key with the same name.",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "maxLength": 20
    }
  }
}
